# CMIS Server Configuration
# Copy this file to .env and fill in your values

# Your SharePoint Embedded Container Type ID
CONTAINER_TYPE_ID=your-container-type-id-here

# Basic Auth Credentials
CMIS_USERNAME=your-username
CMIS_PASSWORD=your-password

# Container name to use for testing (defaults to "CMIS Test")
CMIS_CONTAINER_NAME=CMIS Test

# Optional: Override the base URL (defaults to localhost:7071; point this at
# your Azure deployment to test a live server instead of a local one)
# CMIS_BASE_URL=http://localhost:7071

# Optional: Override the sample data folder uploaded by sync_docs_folder()
# (defaults to the bundled ./sample_data folder)
# CMIS_SAMPLE_DATA_FOLDER=./sample_data
